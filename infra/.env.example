# ─────────────────────────────────────────────────────────────────────────────
# dev-agents infrastructure environment variables
# Copy to .env and fill in all values marked <CHANGE_ME>
# Generate random secrets with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Plane CE ─────────────────────────────────────────────────────────────────

# Public URL Plane is served at (no trailing slash)
PLANE_URL=http://your-hostname:8181

# Port the Plane nginx proxy binds on the host
PLANE_HTTP_PORT=8181

# Django secret key — generate: openssl rand -hex 32
PLANE_SECRET_KEY=<CHANGE_ME>

# PostgreSQL password for the plane database user
PLANE_DB_PASSWORD=<CHANGE_ME>

# Number of gunicorn workers for the API (2 is fine for single-server)
PLANE_GUNICORN_WORKERS=2

# MinIO (S3-compatible object storage for Plane file uploads)
MINIO_ROOT_USER=plane-minio
MINIO_ROOT_PASSWORD=<CHANGE_ME>
MINIO_BUCKET=uploads
MINIO_REGION=us-east-1

# Max file upload size in bytes (default 5 MB)
FILE_SIZE_LIMIT=5242880

# ── Forgejo ───────────────────────────────────────────────────────────────────

# Public URL Forgejo is served at (no trailing slash)
FORGEJO_URL=http://localhost:3000

# Host ports for Forgejo HTTP and SSH
FORGEJO_HTTP_PORT=13000
FORGEJO_SSH_PORT=12222

# Hostname agents use for SSH clone URLs
FORGEJO_SSH_DOMAIN=localhost

# PostgreSQL password for the forgejo database user
FORGEJO_DB_PASSWORD=<CHANGE_ME>

# Forgejo secret keys — generate each with: openssl rand -hex 32
FORGEJO_SECRET_KEY=<CHANGE_ME>
FORGEJO_INTERNAL_TOKEN=<CHANGE_ME>

# Set to "true" after creating the initial admin account to block self-registration
FORGEJO_DISABLE_REGISTRATION=false

# Webhook delivery — allow localhost targets (needed when Plane runs on same host)
FORGEJO_WEBHOOK_SKIP_TLS=true

# ── Forgejo Actions runner ────────────────────────────────────────────────────
# Obtain from Forgejo after first start:
#   Site Administration → Actions → Runners → Create runner → copy token
# Leave blank until you have it; the runner service will fail to register otherwise.
FORGEJO_RUNNER_TOKEN=

# ── Forgejo mailer (optional) ─────────────────────────────────────────────────
FORGEJO_MAILER_ENABLED=false
FORGEJO_SMTP_HOST=
FORGEJO_SMTP_PORT=587
FORGEJO_SMTP_FROM=
FORGEJO_SMTP_USER=
FORGEJO_SMTP_PASSWORD=

# ── Agent API keys ────────────────────────────────────────────────────────────
# Direct Anthropic API key — NOT a subscription; pay-as-you-go required.
ANTHROPIC_API_KEY=<CHANGE_ME>

# OpenRouter API key — alternative to direct Anthropic.
# Set this to route Phase 4 reviewer agents through openrouter.ai (supports
# Anthropic, OpenAI, Gemini, Mistral, local Ollama, and hundreds of others).
# Leave blank to fall back to ANTHROPIC_API_KEY.
OPENROUTER_API_KEY=

# Plane API token (obtained from Plane profile settings after first login)
PLANE_API_TOKEN=
PLANE_WEBHOOK_SECRET=<CHANGE_ME>

# Forgejo API token (obtained from Forgejo user settings after first login)
FORGEJO_API_TOKEN=
FORGEJO_WEBHOOK_SECRET=<CHANGE_ME>

# ── Event bus (Phase 2) ───────────────────────────────────────────────────────

# Host port the webhook receiver listens on
EVENT_BUS_PORT=8090

# Workspace slug configured in Plane
PLANE_WORKSPACE_SLUG=dev-agents

# Log level for event-bus containers (DEBUG|INFO|WARNING|ERROR)
EVENT_BUS_LOG_LEVEL=INFO

# ── Temporal durable workflows (Phase 6) ──────────────────────────────────────
# Leave blank to use the simpler RQ-based flow (no Temporal required).
# Set this to enable the durable workflow path and signal-based PR approval.
# Value must be reachable from inside Docker: use "temporal:7233" when co-located,
# or the host IP when running Temporal externally.
TEMPORAL_ADDRESS=
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_DB_PASSWORD=temporal-dev

# ── Idea & Planner agents (Phase 5) ──────────────────────────────────────────
# Plane project ID — get this from the Plane project URL after creating a project
# e.g. http://localhost:8181/dev-agents/projects/<uuid>/issues/
PLANE_PROJECT_ID=

# Model overrides for idea/planner agents (litellm model strings)
MODEL_IDEA=openrouter/anthropic/claude-sonnet-4-6
MODEL_PLANNER=openrouter/anthropic/claude-sonnet-4-6

# ── Reviewer agent models (Phase 4) ──────────────────────────────────────────
# litellm model strings — prefix with openrouter/ for OpenRouter routing,
# anthropic/ for direct Anthropic, ollama/ for local Ollama.
MODEL_REVIEWER=openrouter/anthropic/claude-sonnet-4-6
MODEL_TESTER=openrouter/anthropic/claude-haiku-4-5
MODEL_SECURITY=openrouter/anthropic/claude-haiku-4-5

# Default target repo when story description doesn't specify one (owner/name)
DEFAULT_REPO=devadmin/sandbox

# ── Phase 7: sandboxing, limits, telemetry ────────────────────────────────────

# Sandbox mode: "process" (default, in-process) or "docker" (ephemeral container per job).
# Docker mode requires the Docker socket mounted in event-bus-worker (see docker-compose.yml).
SANDBOX_MODE=process
# Image used for Docker sandbox containers — must match the built event-bus image tag.
SANDBOX_IMAGE=dev-agents/event-bus:latest
# Per-container resource limits when SANDBOX_MODE=docker
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0

# Rate limits per role (LLM calls per minute; 0 = unlimited)
# Override via PATCH /api/config {"limits": {"max_rpm_reviewer": 20}}
# Defaults are defined in LimitsConfig (event-bus/src/event_bus/config_store.py)

# Concurrency limits (max simultaneous running jobs per role; 0 = unlimited)
# Override via PATCH /api/config {"limits": {"max_concurrent_reviewer": 5}}
